# Copy to .env.local. Never commit real credentials.
OPENAI_API_KEY=""
OPENAI_TEXT_MODEL="gpt-6-luna"
OPENAI_SPEECH_MODEL="gpt-realtime-2.1-mini"
OPENAI_VOICE="marin"

# Optional: a separate long random secret. Otherwise the API key signs narration.
NARRATION_SIGNING_SECRET=""

# Optional canonical deployment origin, for example https://your-app.vercel.app.
APP_ORIGIN=""

# Limits are per server process without Redis and shared across instances with it.
# These request counts are NOT a guaranteed dollar spending cap.
DAILY_LESSON_LIMIT="20"
DAILY_SPEECH_LIMIT="180"
DAILY_CHAT_LIMIT="120"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
# Vercel's trusted address header is used automatically on Vercel.
TRUST_PROXY="false"
